# Generated binaries stay on the build box + the web server, not in git (2026-10-02).
# Code, docs, catalog, recipes, prompts, manifests, tests and ratings are tracked.
*.glb
*.gltf
*.bin
*.fbx
*.obj
*.stl
*.blend
*.blend1
*.png
*.jpg
*.jpeg
*.webp
*.ktx2
*.exr
*.hdr
*.mp4
*.webm
*.zip
*.tar
*.gz
*.npz
*.npy
*.pt
*.safetensors
tools/spawn-tuner/shots/
node_modules/
*.bak

# Agent and worker logs stay out of git (2026-10-21, docs/LICENSING_AUDIT.md §6): they quote whatever the worker
# grepped, wiki lines included. Already-tracked logs stay tracked until the public-export decision.
*.codex.log
worker-logs/
experiments/**/*.log

# the link preview picture (og:image, 2026-10-23; engine/tools/og_card.py) ships with the client
!engine/client/site/og-*.jpg

# the banks' generated pictures and rock (2026-10-24, engine/client/terrain.js): binaries on the build box, like every mesh
engine/client/data/terrain
# the caves' rock chunks (2026-10-25, engine/client/caves.js; experiments/2026-10-25-caves-game/prep_chunks.mjs)
engine/client/data/caves
# the table music (2026-10-30, client/music.js; engine/tools/build_music.sh makes it from the masters on the USB disk)
engine/client/data/music
# the assets page and its data and pictures: generated at every deploy (engine/tools/build_site.py, tools/site-assets/media.py)
engine/client/site/assets.html
engine/client/site/assets.json
engine/client/site/library/
